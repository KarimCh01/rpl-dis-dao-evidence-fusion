.62,136.04,87.48,136.04,87.48],[3509.62,3531.75,136.04,87.48,136.5,60.29],[3531.75,3533.21,136.5,60.29,136.5,60.29],[3533.21,3586.16,136.5,60.29,50.24,11.7],[3586.16,3588.39,50.24,11.7,50.24,11.7],[3588.39,3636.88,50.24,11.7,2.59,77.58],[3636.88,3646.63,2.59,77.58,2.59,77.58]]};
var K = {};
for (var i in S) { K[i] = 0; }
function place(t) {
  for (var i in S) {
    var s = S[i];
    var j = K[i];
    while (j < s.length - 1 && t > s[j][1]) { j++; }
    K[i] = j;
    var g = s[j];
    var f = g[1] > g[0] ? Math.min(1, Math.max(0, (t - g[0]) / (g[1] - g[0]))) : 1;
    sim.getMoteWithID(parseInt(i)).getInterfaces().getPosition()
       .setCoordinates(g[2] + f * (g[4] - g[2]), g[3] + f * (g[5] - g[3]), 0);
  }
}
var mobile = Object.keys(S).length > 0;
if (mobile) { GENERATE_MSG(1000, "mv"); }
while (true) {
  YIELD();
  if (msg.equals("mv")) {
    place(time / 1000000.0);
    GENERATE_MSG(1000, "mv");
  } else if (msg.startsWith("#")) {
    log.log(time + " " + id + " " + msg + "\n");
  }
}
]]></script>
